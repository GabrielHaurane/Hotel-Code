# Copiar este archivo a .env y completar los valores.
# Todas las variables leídas en el cliente deben empezar con VITE_.

# URL base de la API (sin barra final). Si no se define, se usa http://localhost:4000/api
VITE_API_URL=https://hotel-code-backend.onrender.com/api

# EmailJS (formulario de Contacto)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
